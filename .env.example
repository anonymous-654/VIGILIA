# Azure deployments are used for students, corruption generation and judgments.
AZUREOPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_HELPER_DEPLOYMENT=gpt-4.1-mini

# Set only the credentials/endpoints for the teacher routes you use.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMMA_BASE_URL=http://localhost:8000/v1
GEMMA_12B_BASE_URL=http://localhost:8000/v1
GEMMA_NT_BASE_URL=http://localhost:8000/v1
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_38_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_TIMEOUT_SECONDS=300
LOCAL_LLM_MAX_ATTEMPTS=2

# Optional shared root for generated data (relative to the repository).
AGENTS_WILD_DATA_DIR=data
